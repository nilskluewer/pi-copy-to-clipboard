{
  "name": "@nilskluewer/pi-copy-to-clipboard",
  "version": "1.0.2",
  "description": "A Pi extension that copies exact text, commands, and code to the system clipboard without executing it.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "clipboard",
    "copy",
    "maccy",
    "macos",
    "linux",
    "windows",
    "wsl",
    "wayland"
  ],
  "author": {
    "name": "Nils Klüwer",
    "url": "https://github.com/nilskluewer"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilskluewer/pi-copy-to-clipboard.git"
  },
  "bugs": {
    "url": "https://github.com/nilskluewer/pi-copy-to-clipboard/issues"
  },
  "homepage": "https://github.com/nilskluewer/pi-copy-to-clipboard#readme",
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "src"
  ],
  "pi": {
    "extensions": [
      "./extensions/copy-to-clipboard.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "pack:dry": "npm pack --dry-run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm test && npm run smoke",
    "test": "node --test tests/clipboard.test.mjs",
    "test:clipboard": "node --test tests/clipboard.integration.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
