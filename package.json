{
  "name": "@nilskluewer/pi-copy-to-clipboard",
  "version": "1.0.1",
  "description": "A Pi extension that copies exact text, commands, and code to the system clipboard without executing it.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "clipboard",
    "copy",
    "maccy",
    "macos"
  ],
  "author": {
    "name": "Nils Klüwer",
    "url": "https://github.com/nilskluewer"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilskluewer/pi-copy-to-clipboard.git"
  },
  "bugs": {
    "url": "https://github.com/nilskluewer/pi-copy-to-clipboard/issues"
  },
  "homepage": "https://github.com/nilskluewer/pi-copy-to-clipboard#readme",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/copy-to-clipboard.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "pack:dry": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
